# 1 = développement, 0 = production
DEBUG=1
# Obligatoire en production : longue chaîne aléatoire
CLE_SECRETE=cle-de-developpement-a-changer

# Base de données MySQL
BD_NOM=pharmacie
BD_UTILISATEUR=root
BD_MOT_DE_PASSE=
BD_HOTE=127.0.0.1
BD_PORT=3306

# 1 = utiliser SQLite au lieu de MySQL (tests rapides uniquement)
UTILISER_SQLITE=0

# Sauvegardes
# Dossier principal (vide = backend\sauvegardes)
DOSSIER_SAUVEGARDES=
# Copie de secours : clé USB, autre disque ou dossier OneDrive / Google Drive (vide = pas de copie)
DOSSIER_SAUVEGARDES_COPIE=
# Sauvegarde automatique si la dernière date de plus de N heures (0 = désactivée)
SAUVEGARDE_INTERVALLE_HEURES=6
SAUVEGARDES_JOURS_CONSERVATION=30
# Copie automatique sur clé USB / disque externe préparé (Paramètres > Sauvegardes) ; 0 = désactivée
SAUVEGARDE_USB_INTERVALLE_HEURES=24
SAUVEGARDE_USB_NOMBRE=5
# Dossier de mysqldump.exe / mysql.exe (vide = détection automatique WampServer, XAMPP, MySQL…)
CHEMIN_MYSQL_BIN=

# Origines autorisées pour le frontend (séparées par des virgules)
ORIGINES_CORS=http://localhost:5173
